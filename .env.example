# BytePlus ModelArk（ap-southeast-1。https://ai.byteplus.com/ark/region:ap-southeast-1/apikey で発行）
# 手元では Windows のユーザー環境変数を WSLENV で渡しているので、ここに書かなくてもよい
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# NewsData.io API (https://newsdata.io/api-key で無料発行)
NEWS_API_KEY=

# Gmail 送信設定
# 送信元 Gmail アドレス
GMAIL_USER=your-address@gmail.com
# Google アカウント > セキュリティ > 2段階認証 > アプリパスワード で生成した16文字のパスワード
GMAIL_APP_PASSWORD=

# 配信先メールアドレス（自分自身でも可）
RECIPIENT_EMAIL=recipient@example.com

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI News Digest</title>
</head>
<!--
  DADS（デジタル庁デザインシステム）準拠。値は src/mail/dads-palette.ts の表だけを使う（テストで検査）。
  Gmail は CSS 変数・外部 CSS・Web フォントを読まないので、役割トークンを実際の値にしてインラインで書く。
  余白は 8px 基準（4/8/12/16/24）、字は 12/14/15/18px、太さは 400/700 のみ。
-->
<body style="margin:0;padding:0;background-color:#f3f5f8;color:#1a1c1f;font-family:'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;font-size:14px;line-height:1.7;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f5f8;padding:16px 0;">
    <tr>
      <td align="center" style="padding:0 8px;">
        <!-- 1 カラム。スマホの Gmail でも折り返しが崩れないよう、幅は最大 600px の可変にする -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">

          <!-- ヘッダー（app-header: 白地・下罫線） -->
          <tr>
            <td style="background-color:#ffffff;border:1px solid #dde2e8;border-bottom:4px solid #378bca;border-radius:12px 12px 0 0;padding:16px 24px;">
              <h1 style="margin:0;font-size:18px;font-weight:700;line-height:1.5;color:#1a1c1f;">AI News Digest</h1>
              <p style="margin:4px 0 0;font-size:12px;font-weight:400;color:#52585f;">{{deliveryDate}}・{{totalCount}}件の記事</p>
            </td>
          </tr>

          {{#if hasTrends}}
          <!-- 今週のトレンド（記事より前に置く） -->
          <tr>
            <td style="background-color:#ffffff;border-left:1px solid #dde2e8;border-right:1px solid #dde2e8;padding:16px 24px 8px;">
              <h2 style="margin:0 0 8px;font-size:15px;font-weight:700;line-height:1.5;color:#1b4f7a;">今週のトレンド</h2>
              {{#each trends}}
              <div style="margin:0 0 8px;padding:12px 16px;background-color:#eaf3fb;border-radius:8px;">
                <p style="margin:0;font-size:14px;font-weight:700;color:#1a1c1f;">{{trend}}</p>
                <p style="margin:4px 0 0;font-size:14px;font-weight:400;color:#52585f;">{{description}}</p>
                {{#if action}}
                <p style="margin:4px 0 0;font-size:14px;font-weight:700;color:#1b4f7a;">試す: {{action}}</p>
                {{/if}}
              </div>
              {{/each}}
            </td>
          </tr>
          {{/if}}

          <!-- カテゴリ別の記事（card） -->
          {{#each categories}}
          <tr>
            <td style="background-color:#ffffff;border-left:1px solid #dde2e8;border-right:1px solid #dde2e8;padding:16px 24px 8px;">
              <h2 style="margin:0 0 8px;font-size:15px;font-weight:700;line-height:1.5;color:#1b4f7a;">{{name}}<span style="font-size:12px;font-weight:400;color:#52585f;">（{{articles.length}}件）</span></h2>
              {{#each articles}}
              <div style="margin:0 0 12px;padding:12px 16px;background-color:#ffffff;border:1px solid #dde2e8;border-radius:12px;">
                <a href="{{url}}" style="display:block;margin:0 0 8px;font-size:15px;font-weight:700;line-height:1.5;color:#1b4f7a;text-decoration:underline;">{{title}}</a>
                {{#if summary}}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.7;color:#1a1c1f;">
                  <tr>
                    <td style="width:3em;vertical-align:top;padding:0 0 4px;font-size:12px;font-weight:700;color:#52585f;white-space:nowrap;">何が</td>
                    <td style="vertical-align:top;padding:0 0 4px;">{{summary.what}}</td>
                  </tr>
                  {{#if summary.change}}
                  <tr>
                    <td style="width:3em;vertical-align:top;padding:0 0 4px;font-size:12px;font-weight:700;color:#52585f;white-space:nowrap;">差分</td>
                    <td style="vertical-align:top;padding:0 0 4px;">{{summary.change}}</td>
                  </tr>
                  {{/if}}
                  {{#if summary.tryIt}}
                  <tr>
                    <td style="width:3em;vertical-align:top;padding:0 0 4px;font-size:12px;font-weight:700;color:#1b4f7a;white-space:nowrap;">試す</td>
                    <td style="vertical-align:top;padding:0 0 4px;font-weight:700;color:#1b4f7a;">{{summary.tryIt}}</td>
                  </tr>
                  {{/if}}
                </table>
                {{else}}
                <p style="margin:0;font-size:14px;font-weight:400;color:#52585f;">{{excerpt}}</p>
                {{/if}}
                <p style="margin:8px 0 0;font-size:12px;font-weight:400;line-height:1.5;color:#52585f;">
                  <span style="display:inline-block;padding:2px 8px;border-radius:999px;background-color:#e6e6e6;color:#52585f;font-weight:700;">{{sourceName}}</span>
                  {{#if githubUrl}}<a href="{{githubUrl}}" style="display:inline-block;margin-left:4px;padding:2px 8px;border-radius:999px;background-color:#d7e8f6;color:#1b4f7a;font-weight:700;text-decoration:underline;">GitHub</a>{{/if}}
                  <span style="margin-left:8px;">{{publishedAt}}</span>
                </p>
              </div>
              {{/each}}
            </td>
          </tr>
          {{/each}}

          <!-- フッター -->
          <tr>
            <td style="background-color:#ffffff;border:1px solid #dde2e8;border-top:1px solid #eef1f5;border-radius:0 0 12px 12px;padding:16px 24px;">
              {{#if sourceNotes.length}}
              <!-- 取得元の状態（alert.warning: 色と文言の両方で伝える） -->
              <div role="status" style="margin:0 0 12px;padding:12px 16px;background-color:#fbf0da;border:1px solid #9a6206;border-radius:8px;color:#9a6206;">
                <p style="margin:0 0 4px;font-size:14px;font-weight:700;">取得元の状態</p>
                {{#each sourceNotes}}
                <p style="margin:0;font-size:14px;font-weight:400;">・{{this}}</p>
                {{/each}}
              </div>
              {{/if}}
              <p style="margin:0;font-size:12px;font-weight:400;color:#52585f;text-align:center;">このメールは GitHub Actions によって自動送信されています。</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>

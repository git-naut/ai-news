<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI News Digest</title>
</head>
<body style="margin:0;padding:0;background-color:#f5f5f5;font-family:-apple-system,'Helvetica Neue',Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f5f5;padding:20px 0;">
    <tr>
      <td align="center">
        <!-- 1 カラム。スマホの Gmail でも折り返しが崩れないよう、幅は最大 600px の可変にする -->
        <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">

          <!-- ヘッダー -->
          <tr>
            <td style="background-color:#1a1a2e;border-radius:8px 8px 0 0;padding:24px 24px;">
              <h1 style="margin:0;color:#ffffff;font-size:22px;font-weight:700;">◆ AI News Digest</h1>
              <p style="margin:8px 0 0;color:#a0a0c0;font-size:14px;">{{deliveryDate}} ・ {{totalCount}}件の記事</p>
            </td>
          </tr>

          {{#if hasTrends}}
          <!-- 今週のトレンド（記事より前に置く） -->
          <tr>
            <td style="background-color:#ffffff;padding:16px 24px;border-left:1px solid #e0e0e0;border-right:1px solid #e0e0e0;">
              <h2 style="margin:0 0 12px;font-size:15px;font-weight:700;color:#1a1a2e;border-left:4px solid #1a73e8;padding-left:10px;">▲ 今週のトレンド</h2>
              {{#each trends}}
              <div style="margin-bottom:8px;padding:10px 14px;background-color:#f8f9ff;border-radius:6px;">
                <p style="margin:0 0 3px;font-size:14px;font-weight:600;color:#1a1a2e;">{{trend}}</p>
                <p style="margin:0;font-size:13px;color:#555;line-height:1.6;">{{description}}</p>
                {{#if action}}
                <p style="margin:5px 0 0;font-size:12px;color:#1a73e8;font-weight:600;">→ 試す: {{action}}</p>
                {{/if}}
              </div>
              {{/each}}
            </td>
          </tr>
          {{/if}}

          <!-- カテゴリ別の記事（1 カラム） -->
          {{#each categories}}
          <tr>
            <td style="background-color:#ffffff;padding:16px 24px;border-left:1px solid #e0e0e0;border-right:1px solid #e0e0e0;border-top:1px solid #f0f0f0;">
              <h2 style="margin:0 0 10px;font-size:15px;font-weight:700;color:#1a1a2e;border-left:4px solid #34a853;padding-left:10px;">
                {{icon}} {{name}} <span style="font-size:12px;font-weight:400;color:#888;">({{articles.length}}件)</span>
              </h2>
              {{#each articles}}
              <div style="margin-bottom:10px;padding:12px 14px;border:1px solid #e8e8e8;border-radius:6px;background-color:#fafafa;">
                <a href="{{url}}" style="text-decoration:none;color:#1a73e8;font-size:15px;font-weight:600;line-height:1.45;display:block;margin-bottom:8px;">{{title}}</a>
                {{#if summary}}
                <table width="100%" cellpadding="0" cellspacing="0" style="font-size:13px;color:#333;line-height:1.6;">
                  <tr>
                    <td style="width:3em;vertical-align:top;color:#888;white-space:nowrap;">何が</td>
                    <td style="vertical-align:top;padding-bottom:3px;">{{summary.what}}</td>
                  </tr>
                  <tr>
                    <td style="width:3em;vertical-align:top;color:#888;white-space:nowrap;">差分</td>
                    <td style="vertical-align:top;padding-bottom:3px;">{{summary.change}}</td>
                  </tr>
                  {{#if summary.tryIt}}
                  <tr>
                    <td style="width:3em;vertical-align:top;color:#1a73e8;white-space:nowrap;">試す</td>
                    <td style="vertical-align:top;color:#1a73e8;">{{summary.tryIt}}</td>
                  </tr>
                  {{/if}}
                </table>
                {{else}}
                <p style="margin:0;font-size:13px;color:#555;line-height:1.6;">{{excerpt}}</p>
                {{/if}}
                <p style="margin:8px 0 0;font-size:11px;color:#999;">
                  <span style="color:#888;background-color:#f0f0f0;padding:2px 6px;border-radius:3px;">{{sourceName}}</span>
                  {{#if githubUrl}}<a href="{{githubUrl}}" style="color:#fff;background-color:#24292e;padding:2px 6px;border-radius:3px;text-decoration:none;margin-left:4px;">GitHub</a>{{/if}}
                  <span style="margin-left:6px;">{{publishedAt}}</span>
                </p>
              </div>
              {{/each}}
            </td>
          </tr>
          {{/each}}

          <!-- フッター -->
          <tr>
            <td style="background-color:#f0f0f0;padding:20px 24px;border-radius:0 0 8px 8px;border:1px solid #e0e0e0;border-top:none;">
              <p style="margin:0;font-size:12px;color:#888;text-align:center;">このメールは GitHub Actions によって自動送信されています。</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
